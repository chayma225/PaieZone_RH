<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd
                        http://www.liquibase.org/xml/ns/dbchangelog-ext http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd">
    <!--
        Added the constraints for entity Advance.
    -->
    <changeSet id="20260331181210-2" author="jhipster">

        <addForeignKeyConstraint baseColumnNames="employee_id"
                                 baseTableName="advance"
                                 constraintName="fk_advance__employee_id"
                                 referencedColumnNames="id"
                                 referencedTableName="employee"
                                 />

        <addForeignKeyConstraint baseColumnNames="pay_slip_id"
                                 baseTableName="advance"
                                 constraintName="fk_advance__pay_slip_id"
                                 referencedColumnNames="id"
                                 referencedTableName="pay_slip"
                                 />

        <addForeignKeyConstraint baseColumnNames="approved_by_user_id"
                                 baseTableName="advance"
                                 constraintName="fk_advance__approved_by_user_id"
                                 referencedColumnNames="id"
                                 referencedTableName="user_profile"
                                 />
    </changeSet>
</databaseChangeLog>
