<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
  xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

  <changeSet id="20260517-advance-add-reason" author="paiezone">
    <preConditions onFail="MARK_RAN">
      <not><columnExists tableName="advance" columnName="reason"/></not>
    </preConditions>
    <addColumn tableName="advance">
      <column name="reason" type="varchar(500)"/>
    </addColumn>
  </changeSet>

  <changeSet id="20260517-advance-add-approved-at" author="paiezone">
    <preConditions onFail="MARK_RAN">
      <not><columnExists tableName="advance" columnName="approved_at"/></not>
    </preConditions>
    <addColumn tableName="advance">
      <column name="approved_at" type="timestamp"/>
    </addColumn>
  </changeSet>

</databaseChangeLog>
