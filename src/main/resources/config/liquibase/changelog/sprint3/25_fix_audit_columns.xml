  ══════════════════════════════════════════════════════════ -->
  <changeSet id="fix-audit-rubrique-created-by" author="dev">
    <preConditions onFail="MARK_RAN">
      <tableExists tableName="rubrique"/>
      <not><columnExists tableName="rubrique" columnName="created_by"/></not>
