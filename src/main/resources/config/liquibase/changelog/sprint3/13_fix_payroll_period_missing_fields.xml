<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
  xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.6.xsd">

  <changeSet id="sprint3-13-payroll-period-audit-fix" author="dev">
    <preConditions onFail="MARK_RAN">
      <tableExists tableName="payroll_period"/>
    </preConditions>

    <!-- La colonne qui a causé l'erreur SQL spécifique -->
    <addColumn tableName="payroll_period">
      <column name="closed_by" type="varchar(100)"/>
    </addColumn>

    <!-- Sécurité pour les autres colonnes d'audit demandées par Hibernate -->
    <addColumn tableName="payroll_period">
      <column name="created_by" type="varchar(50)" defaultValue="system">
        <constraints nullable="false"/>
      </column>
      <column name="created_date" type="timestamp" defaultValueComputed="CURRENT_TIMESTAMP">
        <constraints nullable="false"/>
      </column>
      <column name="last_modified_by" type="varchar(50)"/>
      <column name="last_modified_date" type="timestamp"/>
    </addColumn>
  </changeSet>

</databaseChangeLog>
