      <column name="min_income"      valueNumeric="10000.000"/>
      <column name="max_income"      valueNumeric="20000.000"/>
      <column name="rate"            valueNumeric="0.2500"/>
      <column name="fixed_deduction" valueNumeric="1750.000"/>
      <column name="sort_order"      valueNumeric="3"/>
    </insert>

    <!-- Tranche 4 : 20 000 – 30 000 TND → 30 % -->
