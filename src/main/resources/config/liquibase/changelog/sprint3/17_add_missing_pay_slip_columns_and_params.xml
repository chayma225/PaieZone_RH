<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
  xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.6.xsd">

  <!-- ============================================================
       PHASE 1 — Colonnes manquantes dans pay_slip
       ============================================================ -->

  <changeSet id="phase1-payslip-css" author="paiezone">
    <preConditions onFail="MARK_RAN">
      <not><columnExists tableName="pay_slip" columnName="css_amount"/></not>
    </preConditions>
    <comment>CSS — Contribution Sociale de Solidarité (0.5%)</comment>
    <addColumn tableName="pay_slip">
      <column name="css_amount" type="decimal(15,3)" defaultValueNumeric="0">
        <constraints nullable="false"/>
      </column>
    </addColumn>
  </changeSet>

  <changeSet id="phase1-payslip-tfp" author="paiezone">
    <preConditions onFail="MARK_RAN">
      <not><columnExists tableName="pay_slip" columnName="tfp_amount"/></not>
    </preConditions>
    <comment>TFP — Taxe Formation Professionnelle patronale (1%)</comment>
    <addColumn tableName="pay_slip">
      <column name="tfp_amount" type="decimal(15,3)" defaultValueNumeric="0">
        <constraints nullable="false"/>
      </column>
    </addColumn>
  </changeSet>

  <changeSet id="phase1-payslip-unpaid-leave-deduction" author="paiezone">
    <preConditions onFail="MARK_RAN">
      <not><columnExists tableName="pay_slip" columnName="unpaid_leave_deduction"/></not>
    </preConditions>
    <comment>Montant déduit pour congés non payés</comment>
    <addColumn tableName="pay_slip">
      <column name="unpaid_leave_deduction" type="decimal(15,3)" defaultValueNumeric="0">
        <constraints nullable="false"/>
      </column>
    </addColumn>
  </changeSet>

  <changeSet id="phase1-payslip-overtime-amount" author="paiezone">
    <preConditions onFail="MARK_RAN">
      <not><columnExists tableName="pay_slip" columnName="overtime_amount"/></not>
    </preConditions>
    <comment>Montant total des heures supplémentaires calculé</comment>
    <addColumn tableName="pay_slip">
      <column name="overtime_amount" type="decimal(15,3)" defaultValueNumeric="0">
        <constraints nullable="false"/>
      </column>
    </addColumn>
  </changeSet>

  <!-- ============================================================
       PHASE 1 — Nouveaux paramètres réglementaires
       Tous les taux sont pilotables par le Super Admin
       ============================================================ -->

  <changeSet id="phase1-param-cnss-salarial" author="paiezone">
    <preConditions onFail="MARK_RAN">
      <sqlCheck expectedResult="0">
        SELECT COUNT(*) FROM regulatory_param
        WHERE param_key = 'CNSS_TAUX_SALARIAL' AND active = true
      </sqlCheck>
    </preConditions>
    <comment>CNSS Taux Salarié 9.18% — pilotable Super Admin</comment>
    <insert tableName="regulatory_param">
      <column name="param_key"       value="CNSS_TAUX_SALARIAL"/>
      <column name="param_label"     value="Taux CNSS salarié (9.18%)"/>
      <column name="numeric_value"   valueNumeric="0.0918"/>
      <column name="category"        value="SOCIAL"/>
      <column name="effective_from"  valueDate="2024-01-01"/>
      <column name="legal_reference" value="Art. 48 Code du Travail Tunisien"/>
      <column name="active"          valueBoolean="true"/>
    </insert>
  </changeSet>

