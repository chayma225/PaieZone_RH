    <insert tableName="cnss_rate">
      <column name="id" valueComputed="nextval('sequence_generator')"/>
      <column name="year" valueNumeric="2024"/>
      <column name="salary_ceiling" valueNumeric="2700.000"/>
      <column name="employee_rate" valueNumeric="0.0918"/>
      <column name="employer_rate" valueNumeric="0.1657"/>
      <column name="cavis_employee" valueNumeric="0.0100"/>
      <column name="cavis_employer" valueNumeric="0.0100"/>
      <column name="smig" valueNumeric="450.000"/>
